#!/bin/sh
# git-credential-secret — git credential helper backed by the freedesktop
# Secret Service (GNOME Keyring, KWallet, ...) through `secret-tool`.
#
# Why this exists: Debian and Ubuntu build git WITHOUT git-credential-libsecret;
# they only ship its source in /usr/share/doc/git/contrib/credential/libsecret,
# so the "official" way is to compile it with libsecret-1-dev — and the binary
# lands in that doc directory, which is replaced on every git upgrade. Fedora
# and Arch package it as a git subpackage, macOS uses osxkeychain.
#
# This script needs nothing but `secret-tool` (apt: libsecret-tools), no
# compiler, no root, and no rebuild after upgrades. It stores one keyring item
# per protocol+host, with the payload "<username>:<password>".
#
# Git protocol: called as `git-credential-<name> get|store|erase` with
# key=value lines on stdin, and must print credential attrs on stdout for get.

set -eu

action="${1:-get}"
[ -n "${1:-}" ] || exit 0

# secret-tool is the only dependency; without it behave like "no credential".
command -v secret-tool >/dev/null 2>&1 || exit 0

protocol=""
host=""
username=""
password=""

while IFS= read -r line; do
  [ -n "$line" ] || continue
  key="${line%%=*}"
  value="${line#*=}"
  case "$key" in
    protocol) protocol="$value" ;;
    host)     host="$value" ;;
    username) username="$value" ;;
    password) password="$value" ;;
  esac
done

[ -n "$host" ] || exit 0

# One keyring item per protocol+host. http and https to the same host are kept
# apart on purpose: they are different origins and can hold different tokens.
service="git:${protocol}://${host}"

case "$action" in
  get)
    # lookup exits non-zero when nothing matches; that is not an error for git,
    # it just means "I have nothing, ask the user".
    stored="$(secret-tool lookup service "$service" 2>/dev/null)" || exit 0
    [ -n "$stored" ] || exit 0
    # A password is allowed to contain ':' — split on the FIRST one only.
    stored_user="${stored%%:*}"
    stored_pass="${stored#*:}"
    [ -n "$stored_user" ] || exit 0
    # If git already knows which user it wants, do not offer a different one.
    if [ -n "$username" ] && [ "$username" != "$stored_user" ]; then
      exit 0
    fi
    printf 'username=%s\npassword=%s\n' "$stored_user" "$stored_pass"
    ;;
  store)
    [ -n "$username" ] && [ -n "$password" ] || exit 0
    printf '%s:%s' "$username" "$password" |
      secret-tool store --label="Git ${protocol}://${host} (${username})" service "$service" >/dev/null 2>&1 || exit 0
    ;;
  erase)
    secret-tool clear service "$service" >/dev/null 2>&1 || exit 0
    ;;
esac

exit 0
