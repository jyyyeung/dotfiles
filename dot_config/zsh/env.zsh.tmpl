# ~/.config/zsh/env.zsh - Environment variables (no secrets)

# Starship config location
export STARSHIP_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/starship/starship.toml"

# Editors & Pagers
export EDITOR="nvim"
export VISUAL="nvim"
export PAGER="less -R"
export LESSHISTFILE="-"

# Dev Paths (prepend, don't replace)
path=(
  $HOME/go/bin
  $HOME/.cargo/bin
  $HOME/.local/bin
  $path
)

# Zsh completions — must be on fpath before compinit (completions.zsh)
fpath+=("${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions")
[[ -d /opt/homebrew/share/zsh/site-functions ]] && fpath+=(/opt/homebrew/share/zsh/site-functions)
[[ -d /usr/local/share/zsh/site-functions ]] && fpath+=(/usr/local/share/zsh/site-functions)
[[ -d /usr/share/zsh/vendor-completions ]] && fpath+=(/usr/share/zsh/vendor-completions)

# Git
export GIT_PAGER="delta"
export DELTA_PAGER="less -R"

# Projects for Project Jump (pj)
export PROJECT_PATHS=(~/projects ~/dev)

# Language Runtimes (mise manages versions)
{{- if .enable_node }}
# NODE_ENV is intentionally NOT exported globally: a global "development" makes
# every `npm ci`, vite/webpack build and `next build` on this machine run in dev
# mode (bigger output, different dependency resolution, slower). Set it per
# project, or in ~/.zshrc.local if you really want it everywhere.
{{- end }}
{{- if .enable_python }}
export PYTHONUNBUFFERED="1"
export PIP_NO_INPUT="1"
{{- end }}

# Kubernetes — must point at a file that exists. kubectl reads the FIRST path
# in the list, so a single kubeconfig keeps this simple.
if [[ -d "$HOME/.kube" ]]; then
  export KUBECONFIG="$HOME/.kube/config"
fi

# Docker
export DOCKER_CLI_EXPERIMENTAL="enabled"

# Disable slow features
export DISABLE_AUTO_TITLE="true"  # Prevent terminal title flicker

# Rust build cache — only set the wrapper when sccache is actually installed,
# otherwise every `cargo` invocation fails with "could not execute process sccache".
if (( $+commands[sccache] )); then
  export RUSTC_WRAPPER=sccache
fi
