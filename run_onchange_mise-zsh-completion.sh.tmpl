#!/usr/bin/env bash
# mise version: {{ if lookPath "mise" }}{{ output "mise" "--version" | trim }}{{ else }}absent{{ end }}
# ^ THIS line is what makes the script re-run: chezmoi keys `run_onchange_` off the
#   rendered CONTENT hash. The old filename tried to encode the version in the
#   script name, but chezmoi never templates source filenames.
set -euo pipefail
command -v mise >/dev/null || exit 0
mise use -g usage 2>/dev/null || true
site="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions"
mkdir -p "$site"
tmp="${site}/_mise.new.$$"
if mise completion zsh >"$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
  mv -f "$tmp" "${site}/_mise"
else
  rm -f "$tmp"
  echo "chezmoi: mise zsh completion not written (run: mise use -g usage)" >&2
fi
