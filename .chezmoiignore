# ============================================================================
# Secrets & credentials
# Patterns are doublestar-matched against the TARGET path (what lands in $HOME),
# NOT the source name: a source file `dot_aws/credentials` is the target
# `.aws/credentials`. Ignoring only stops chezmoi from picking a file up; it
# never un-manages one that is already tracked (use `chezmoi forget` + `git rm`).
# ============================================================================
.config/zsh/secrets.zsh
.config/zsh/*secret*
.netrc
.github/credentials*
.aws/credentials
.aws/config
.ssh/id_*
.ssh/known_hosts
.env
.env.*
**/.env
**/.env.*
*.key
*.pem
*.p12

# Machine-specific state
.local/share/zinit/**/cache/**
.local/state/**
.cache/**

# OS-specific binaries (managed externally)
.local/bin/*

# State directory - machine-specific by default
.local/state/**
!local/state/atuin/**  # ← Uncomment ONLY if you want Atuin history synced

# Cache - never sync
.cache/**

# Local data managed externally
.local/share/**
!.local/share/zinit/**  # ← Keep if managing zinit via chezmoiexternal
!.local/share/fzf/**