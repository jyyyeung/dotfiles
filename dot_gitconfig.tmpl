# ~/.gitconfig - Managed by chezmoi
[user]
  name = "{{ .name }}"
  email = "{{ .email }}"

[core]
  editor = "{{ .editor }}"
  pager = delta
  autocrlf = input
  whitespace = trailing-space,space-before-tab

[init]
  defaultBranch = main

[pull]
  rebase = true

[push]
  default = simple
  autoSetupRemote = true

[merge]
  conflictstyle = diff3
  tool = nvim

[diff]
  tool = nvim
  colorMoved = default
  algorithm = histogram

# Without these, `git difftool` / `git mergetool` fall back to running the tool
# name itself and dump the raw files with no diff view at all.
[difftool "nvim"]
  cmd = nvim -d "$LOCAL" "$REMOTE"
[mergetool "nvim"]
  cmd = nvim -d "$LOCAL" "$MERGED"
  trustExitCode = true

[delta]
  features = side-by-side,line-numbers,decorations
  navigate = true
  side-by-side = true
  line-numbers = true
  hyperlinks = true
  hyperlinks-file-link-format = "file://{path}"
  # Syntax highlighting
  syntax-theme = GitHub

[delta "decorations"]
  commit-decoration-style = bold yellow box
  file-style = bold cyan
  file-decoration-style = ul

[delta "line-numbers"]
  zero-style = dim gray
  left-style = gray
  right-style = gray

[alias]
  # Shortcuts
  s = status -sb
  a = add
  c = commit
  co = checkout
  b = branch
  d = diff
  l = log --oneline --graph --decorate
  p = push
  pl = pull
  # Enhanced
  lg = log --oneline --graph --decorate --all
  dc = diff --cached
  ca = commit -a
  # Cleanup
  prune = "!git fetch --prune && git branch -vv | grep 'gone]' | awk '{print $1}' | xargs -r git branch -d"
  # Lazygit
  lgui = "!lazygit"

# Credential helper — resolved per OS so this stays portable between macOS and
# Linux. NOTE: `helper = store` was deliberately removed; it wrote the token in
# plaintext to ~/.git-credentials.
[credential]
{{- if eq .chezmoi.os "darwin" }}
  helper = osxkeychain
{{- else }}
{{- /* A helper git cannot find is FATAL (it does not fall through to the next
       one), so the helper is detected here, on the machine doing the apply,
       instead of being assumed.

       Order of preference on Linux:
         1. git-credential-libsecret — ships with git on Fedora/Arch, but NOT on
            Debian/Ubuntu, and it is not on PATH (git's exec-path holds it).
         2. our own git-credential-secret, a shell script that stores in the
            same keyring via secret-tool (apt: libsecret-tools). Referenced by
            absolute path so it works even when ~/.local/bin is not on PATH,
            e.g. for GUI git clients.
         3. git's in-memory cache: no plaintext file, but a prompt after reboot. */}}
{{- $execPath := output "git" "--exec-path" | trim }}
{{- if glob (printf "%s/git-credential-libsecret" $execPath) }}
  # Credentials live in the desktop keyring (GNOME Keyring / KWallet via
  # Secret Service): encrypted at rest, survives reboots.
  helper = libsecret
{{- else if lookPath "secret-tool" }}
  # No libsecret helper on this box (Debian/Ubuntu do not package it), so use
  # the dotfiles' own keyring helper instead.
  helper = {{ .chezmoi.homeDir }}/.local/bin/git-credential-secret
{{- else }}
  # No keyring access at all, so fall back to git's own in-memory cache.
  # No plaintext file on disk, but expect a prompt after each reboot.
  helper = cache --timeout=604800
{{- end }}
{{- end }}

# Kept so git stops re-writing this block after every apply. Narrow it to the
# paths you actually need if you ever share this machine.
[safe]
  directory = *
